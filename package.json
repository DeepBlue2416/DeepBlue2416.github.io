{
  "name": "apple-i-tochka",
  "version": "1.0.0",
  "private": true,
  "description": "Лёгкий сверхбыстрый интернет-магазин техники Apple для локального города. Static site + Cloudflare Worker + Telegram.",
  "type": "module",
  "scripts": {
    "css": "tailwindcss -i ./src/assets/css/input.css -o ./src/assets/css/tailwind.css",
    "css:watch": "tailwindcss -i ./src/assets/css/input.css -o ./src/assets/css/tailwind.css --watch",
    "css:min": "tailwindcss -i ./src/assets/css/input.css -o ./src/assets/css/tailwind.css --minify",
    "build": "npm run css:min && node ./scripts/build.js",
    "dev": "concurrently \"npm run css:watch\" \"npm run serve\"",
    "serve": "http-server ./src -p 5173 -c-1",
    "worker:dev": "wrangler dev worker/index.js",
    "worker:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "http-server": "^14.1.1",
    "tailwindcss": "^3.4.17",
    "wrangler": "^3.90.0"
  }
}
